# Copiez ce fichier en .env.local puis relancez le serveur.

# --- Espace gestion --------------------------------------------------------
# Aucune variable ici : la connexion passe par Supabase Authentication. Créez
# le compte dans Authentication > Users, puis inscrivez son adresse dans la
# table `admins` (voir supabase/schema.sql).

# --- Supabase --------------------------------------------------------------
# Sans ces variables, le site tourne sur le catalogue de référence et les
# commandes ne sont gardées qu'en mémoire (perdues au redémarrage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service-role : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Suivi publicitaire ------------------------------------------------------
# Identifiant du pixel Meta. Laissez vide pour ne rien charger : la CSP se
# referme alors d'elle-même sur les domaines Facebook.
# Le back-office n'est jamais suivi, quel que soit le réglage.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Avis de commande par email ---------------------------------------------
# Sans ces deux variables, aucun email n'est tenté et le journal le signale.
# La cle se cree sur resend.com (gratuit jusqu'a 3 000 envois par mois).
RESEND_API_KEY=
# Ou arrivent les avis. Plusieurs adresses possibles, separees par des virgules.
ORDER_NOTIFICATION_EMAIL=
# Facultatif. Par defaut « Lady Fresh <onboarding@resend.dev> », qui fonctionne
# sans domaine verifie. Une fois ladyfresh.dz verifie chez Resend, mettre
# « Lady Fresh <commandes@ladyfresh.dz> » pour ne plus finir en indesirables.
RESEND_FROM=
# Facultatif : sert au lien vers le back-office dans l'email.
NEXT_PUBLIC_SITE_URL=
